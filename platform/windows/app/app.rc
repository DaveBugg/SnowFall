#include <winres.h>
// The manifest (app.manifest) is embedded by CMake/the linker (/MANIFESTINPUT).

// Multi-size snowflake icon generated at build time by snow_art (same art as the tray icon).
1 ICON "SnowFall.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "SnowFall"
            VALUE "FileDescription", "SnowFall - interactive desktop snow"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "SnowFall"
            VALUE "OriginalFilename", "SnowFall.exe"
            VALUE "ProductName", "SnowFall"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
